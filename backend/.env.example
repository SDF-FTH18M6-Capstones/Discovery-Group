# Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-64-characters
JWT_SECRET_KEY=change-me-to-another-long-random-string-of-64-chars
DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot_dev
TEST_DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot_test
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Production: the API refuses to start with the example secrets above
# APP_ENV=production
# DATA_KEY=

# Email. With neither BREVO_API_KEY nor MAIL_SERVER set, emails are printed in the terminal.
# MAIL_FROM=StockPilot <no-reply@your-domain.com>
# BREVO_API_KEY=
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true

# Receipt scanning. Without a key, receipts are read on the user's own device.
# RECEIPT_AI_KEY=
# RECEIPT_AI_MODEL=claude-haiku-5-5

# WhatsApp alerts through Meta's WhatsApp Cloud API. Without these, alerts are only logged.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=stockpilot_alert
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Account security
# EMAIL_VERIFICATION_REQUIRED=true
# LOGIN_CODE_REQUIRED=true
# LOGIN_CODE_EXEMPT_DOMAINS=stockpilot.test,highlandcafe.test
# STAFF_APPROVAL_REQUIRED=true
# LOGIN_RATE_LIMIT=10 per minute
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# StockPilot's own M-Pesa Paybill, for subscription payments: off, simulate, sandbox or live
# MPESA_MODE=simulate
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_PARTY_B=
# MPESA_CALLBACK_BASE=https://your-api.example.com

# Subscriptions and the people who run StockPilot itself
# SUBSCRIPTIONS_REQUIRED=false
# SUBSCRIPTION_PRICE=1500
# PLATFORM_OWNERS=you@example.com

# Shared secret for the evening summary schedule
# TASK_TOKEN=

# Load the demo businesses on start (start.sh)
# SEED_DEMO=false
