FLASK_APP=wsgi.py
# Make each key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-64-characters
JWT_SECRET_KEY=change-me-to-another-long-random-string-of-64-chars
DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot_dev
TEST_DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot_test
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email. Leave all of these empty and emails are printed in the flask run terminal instead.
# Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and put it in SMTP_PASSWORD (not your real password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Or SendGrid instead of Gmail: leave SMTP_HOST empty and set the key.
SENDGRID_API_KEY=

# Local development only: the login response also contains the 6-digit code.
# Never set this to true on the deployed backend.
DEV_SHOW_OTP=true