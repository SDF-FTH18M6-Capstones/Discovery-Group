# Make each key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-64-characters
JWT_SECRET_KEY=change-me-to-another-long-random-string-of-64-chars
DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot_dev
TEST_DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot_test
CORS_ORIGINS=http://localhost:5173
# Where the React app lives: used for links in emails (password reset, notifications)
FRONTEND_URL=http://localhost:5173

# Email. Leave BREVO_API_KEY and MAIL_SERVER empty while developing: emails (links and sign-in
# codes) are printed in the terminal instead.
# Brevo's HTTPS API (use this on Render's free plan, which blocks SMTP). Never commit the real key.
# BREVO_API_KEY=
# SMTP, used when BREVO_API_KEY is empty:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-smtp-password
# Sender for both: must be an address you verified with your email provider
# MAIL_FROM=StockPilot <no-reply@your-domain.com>

# US-02 / US-03: confirm email before first sign-in, and a 6-digit emailed code at each sign-in.
# Both are on by default; turn off on a laptop if you do not want to copy codes from the terminal.
# EMAIL_VERIFICATION_REQUIRED=true
# LOGIN_CODE_REQUIRED=true
# Email domains that skip the code (the demo accounts cannot receive email)
# LOGIN_CODE_EXEMPT_DOMAINS=stockpilot.test,highlandcafe.test
# New staff cannot sign in until the Administrator approves them and picks their role
# STAFF_APPROVAL_REQUIRED=true

# production on a server: refuses to start with the example keys above
# APP_ENV=production
# Sign-in / sign-up attempts per minute per address
# LOGIN_RATE_LIMIT=10 per minute
# memory:// is fine for one process; with several gunicorn workers use Redis so they share counts
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
